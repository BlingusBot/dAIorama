# dai-l1 — L1 preflight image: headless Hyprland + wayvnc + input + noVNC stack
# Base: Debian sid — hyprland 0.56.2 ships in sid main; trixie has none (verified 2026-10-15).
FROM docker.io/library/debian:sid-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      hyprland wayvnc wtype grim slurp \
      novnc websockify \
      xwayland seatd dbus dbus-x11 \
      mesa-utils libgl1-mesa-dri libegl1 libgles2 libgbm1 \
      wayland-utils \
      fontconfig fonts-dejavu-core \
      python3 curl procps ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Runtime notes (P1 L1):
#  - headless: AQ_NO_KMS_REQUIREMENT=1 (documented fallback, 03-architecture) or
#    Hyprland's dedicated virtual-output feature once confirmed on 0.56.x.
#  - render node passed per-run via podman device /dev/dri/renderD128 (see run specs).
#  - wayvnc + noVNC/websockify compose the remote leg; wtype covers keyboard input,
#    pointer tooling TBD (wlr virtual-pointer) in the next iteration.

# Parent-compositor set for the nested path (aquamarine Wayland backend client-side).
RUN apt-get update && apt-get install -y --no-install-recommends sway weston && rm -rf /var/lib/apt/lists/*
# niri (spec's documented fallback) — install if packaged.
RUN apt-get update && (apt-get install -y --no-install-recommends niri || echo "niri not packaged") && rm -rf /var/lib/apt/lists/*

# LD_PRELOAD shim: clamp bind versions aquamarine 0.15.1 requests beyond weston/wlroots
# parents (xdg_wm_base 6, wl_compositor 6, wl_seat 9). Spike-only; see p1-out/headless8.
COPY xdg-clamp.c /tmp/xdg-clamp.c
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libwayland-dev \
    && gcc -O2 -shared -fPIC -o /usr/local/lib/xdg-clamp.so /tmp/xdg-clamp.c -ldl \
    && rm -f /tmp/xdg-clamp.c && rm -rf /var/lib/apt/lists/*

# L1 chain-runner set: mutter (headless parent), foot (wayland terminal), chromium (WebGL leg).
RUN apt-get update && apt-get install -y --no-install-recommends mutter foot && rm -rf /var/lib/apt/lists/*
RUN apt-get update && (apt-get install -y --no-install-recommends hyprland-guiutils || echo no-guiutils) && rm -rf /var/lib/apt/lists/*
RUN apt-get update && (apt-get install -y --no-install-recommends chromium || echo no-chromium) && rm -rf /var/lib/apt/lists/*
RUN apt-get update && (apt-get install -y --no-install-recommends wlrctl || echo no-wlrctl) && rm -rf /var/lib/apt/lists/*
