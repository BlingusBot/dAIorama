{
  "name": "dai-l1-pointer1",
  "image": "localhost/blingus/dai-l1:dev",
  "restart_policy": "no",
  "cap_drop": ["ALL"],
  "devices": [
    {"path": "/dev/dri/renderD128", "type": "c", "major": 226, "minor": 128, "fileMode": 438, "permissions": "rwm"}
  ],
  "mounts": [
    {"type": "bind", "source": "/home/blingus/services/dAIorama/p1-out", "destination": "/out", "options": ["rbind", "rw", "z"]}
  ],
  "command": ["bash", "-c", "dbus-run-session -- bash /out/run-pointer-round.sh > /out/l1-pointer-round.txt 2>&1; echo exit=$? >> /out/l1-pointer-round.txt"]
}
